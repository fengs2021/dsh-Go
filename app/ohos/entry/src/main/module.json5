{
  "module": {
    "name": "entry",
    "type": "entry",
    "compressNativeLibs": true,
    "description": "$string:module_desc",
    "mainElement": "EntryAbility",
    "deviceTypes": [
      "phone",
      "tablet"
    ],
    "deliveryWithInstall": true,
    "installationFree": false,
    "extractNativeLibs": true,
    "libIsolation": false,
    "pages": "$profile:main_pages",
    "abilities": [
      {
        "name": "EntryAbility",
        "srcEntry": "./ets/entryability/EntryAbility.ets",
        "description": "$string:EntryAbility_desc",
        "icon": "$media:layered_image",
        "label": "$string:EntryAbility_label",
        "startWindowIcon": "$media:start_icon",
        "startWindowBackground": "$color:start_window_background",
        "orientation": "auto_rotation_restricted",
        "exported": true,
        "launchType": "singleton",
        "backgroundModes": [
          "dataTransfer",
          "audioPlayback"
        ],
        "metadata": [
          {
            "name": "ohos.ability.shortcuts",
            "resource": "$profile:shortcuts_config"
          }
        ],
        "skills": [
          {
            "entities": [
              "entity.system.home"
            ],
            "actions": [
              "action.system.home"
            ]
          },
          {
            "entities": [
              "entity.system.browsable"
            ],
            "actions": [
              "ohos.want.action.viewData"
            ],
            "uris": [
              {
                "scheme": "dshgo"
              }
            ]
          },
          {
            "actions": [
              "ohos.want.action.viewData"
            ],
            "uris": [
              {
                "scheme": "file",
                "type": "general.file",
                "linkFeature": "FileOpen"
              },
              {
                "scheme": "file",
                "type": "general.plain-text",
                "linkFeature": "FileOpen"
              },
              {
                "scheme": "file",
                "type": "application/octet-stream",
                "linkFeature": "FileOpen"
              },
              {
                "scheme": "file",
                "type": "application/pdf",
                "linkFeature": "FileOpen"
              },
              {
                "scheme": "file",
                "type": "image/*",
                "linkFeature": "FileOpen"
              }
            ]
          },
          {
            "actions": [
              "ohos.want.action.sendData"
            ],
            "uris": [
              {
                "scheme": "file",
                "utd": "general.text",
                "maxFileSupported": 1
              },
              {
                "scheme": "file",
                "utd": "general.image",
                "maxFileSupported": 9
              },
              {
                "scheme": "file",
                "utd": "general.object",
                "maxFileSupported": 9
              },
              {
                "scheme": "file",
                "utd": "general.file",
                "maxFileSupported": 9
              }
            ]
          }
        ]
      }
    ],
    "extensionAbilities": [
      {
        "name": "EngineWakeAbility",
        "srcEntry": "./ets/extension/EngineWakeAbility.ets",
        "label": "$string:EntryAbility_label",
        "description": "$string:module_desc",
        "type": "workScheduler"
      },
      {
        "name": "CompanionFormAbility",
        "srcEntry": "./ets/formability/CompanionFormAbility.ets",
        "label": "$string:companion_widget_label",
        "description": "$string:companion_widget_description",
        "type": "form",
        "metadata": [
          {
            "name": "ohos.extension.form",
            "resource": "$profile:companion_form"
          }
        ]
      }
    ],
    "requestPermissions": [
      {
        "name": "ohos.permission.INTERNET"
      },
      {
        "name": "ohos.permission.GET_NETWORK_INFO"
      },
      {
        "name": "ohos.permission.KEEP_BACKGROUND_RUNNING"
      },
      {
        "name": "ohos.permission.VIBRATE"
      },
      {
        // 画中画系统悬浮窗（window.WindowType.TYPE_FLOAT）。system_basic 级，声明只是
        // 「允许被授予」，实际授权要么靠签名 profile 里的 ACL，要么在 debug 包上用
        // `hdc shell atm perm -g -i <accessTokenId> -p ohos.permission.SYSTEM_FLOAT_WINDOW`
        // 手动给一次。没授权时 FloatWindowManager 静默降级，应用内浮层照常工作。
        "name": "ohos.permission.SYSTEM_FLOAT_WINDOW",
        "reason": "$string:float_window_reason",
        "usedScene": {
          "abilities": [
            "EntryAbility"
          ],
          "when": "always"
        }
      },
      {
        "name": "ohos.permission.FILE_ACCESS_PERSIST"
      },
      {
        "name": "ohos.permission.MICROPHONE",
        "reason": "$string:mic_reason",
        "usedScene": {
          "abilities": [
            "EntryAbility"
          ],
          "when": "inuse"
        }
      }
    ]
  }
}
